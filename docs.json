{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Omnia Voice",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/agents",
              "guides/tools",
              "guides/knowledge-bases",
              "guides/phone-numbers",
              "guides/webhooks",
              "guides/websocket"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/voices-languages",
              "concepts/call-flow"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "api-reference/agents/list",
              "api-reference/agents/create",
              "api-reference/agents/get",
              "api-reference/agents/update",
              "api-reference/agents/delete"
            ]
          },
          {
            "group": "Calls",
            "pages": [
              "api-reference/calls/create",
              "api-reference/calls/list",
              "api-reference/calls/get"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "api-reference/tools/list",
              "api-reference/tools/create",
              "api-reference/tools/get",
              "api-reference/tools/update",
              "api-reference/tools/delete",
              "api-reference/tools/system",
              "api-reference/tools/assign",
              "api-reference/tools/remove"
            ]
          },
          {
            "group": "Phone Numbers",
            "pages": [
              "api-reference/numbers/list",
              "api-reference/numbers/get"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "api-reference/config/voices",
              "api-reference/config/languages"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://dashboard.omnia-voice.com",
          "icon": "gauge"
        },
        {
          "anchor": "API Status",
          "href": "https://status.omnia-voice.com",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@omnia-voice.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.omnia-voice.com"
    }
  },
  "api": {
    "baseUrl": "https://dashboard.omnia-voice.com/api/v1",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    }
  },
  "openapi": "/openapi.yaml",
  "footer": {
    "socials": {
      "website": "https://omnia-voice.com",
      "github": "https://github.com/omnia-voice"
    }
  }
}
